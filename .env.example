# =============================================================================
# ReviewBot AI — Environment Variables
# Copy this file to .env and replace placeholder values with your real keys.
# =============================================================================

# --- LLM APIs (need at least one; Groq recommended) --------------------------

# HOW TO GET: https://console.groq.com → Sign up → API Keys → Create key
# Free tier: ~14,400 requests/day
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# HOW TO GET: https://api.together.xyz → Sign up → API Keys
# Free: $25 starter credit
TOGETHER_API_KEY=
TOGETHER_MODEL=deepseek-ai/DeepSeek-Coder-V2-Lite-Instruct

# HOW TO GET: https://huggingface.co/settings/tokens → New token (read)
# Free inference API tier (rate-limited)
HF_API_TOKEN=
HF_MODEL=bigcode/starcoder2-15b

# HOW TO GET: Install https://ollama.com → run: ollama pull codellama
# No API key needed — runs locally on your machine
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=codellama

# --- GitHub ------------------------------------------------------------------

# HOW TO GET: https://github.com/settings/tokens → Generate new token (classic)
# Required scopes: repo, pull_requests (read and write)
GITHUB_TOKEN=

# HOW TO GET: Generate any random string (e.g. openssl rand -hex 32)
# Paste the SAME value in GitHub repo/org webhook "Secret" field
GITHUB_WEBHOOK_SECRET=

# --- GitLab ------------------------------------------------------------------

# HOW TO GET: GitLab → User Settings → Access Tokens → Add new token
# Scopes: api, read_repository, write_repository
GITLAB_TOKEN=

# Self-hosted GitLab: change base URL. GitLab.com default:
GITLAB_URL=https://gitlab.com

# HOW TO GET: Same as GitHub — random secret, set in project webhook settings
GITLAB_WEBHOOK_SECRET=

# --- Storage -----------------------------------------------------------------

# SQLite path (created automatically). No setup needed for MVP.
DATABASE_URL=sqlite+aiosqlite:///./data/reviewbot.db

# --- Review behavior ---------------------------------------------------------

MAX_COMMENTS_PER_PR=15
LLM_TIMEOUT_SECONDS=30

# --- Server ------------------------------------------------------------------

APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- Optional (post-MVP; leave empty for now) ----------------------------------

# HOW TO GET: https://upstash.com → Create Redis database → copy REST URL
REDIS_URL=

# HOW TO GET: Slack app → Incoming Webhooks → Create webhook URL
SLACK_WEBHOOK_URL=

# HOW TO GET: Discord channel → Integrations → Webhooks → New Webhook
DISCORD_WEBHOOK_URL=
